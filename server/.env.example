# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Deepgram Speech-to-Text (STT)
# Sign up at https://deepgram.com (free $200 credits)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API (LLM & Embeddings)
# Platform: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Text-to-Speech (TTS)
# Platform: https://elevenlabs.io (Free tier available)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # Rachel (or any voice ID)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# MongoDB & Vector DB (for subsequent modules)
MONGODB_URI=mongodb://localhost:27017/salespilot
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_env
